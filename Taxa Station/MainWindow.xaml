        <Image HorizontalAlignment="Center" Height="450" VerticalAlignment="Top" Width="800" Source="/resizeplus_Designer.png" Panel.ZIndex="-2" Margin="0,-16,0,0"/>
        <Image HorizontalAlignment="Left" Height="166" Margin="317,10,0,0" VerticalAlignment="Top" Width="173" Source="/Designer (2).png" Panel.ZIndex="-1"/>

    </Grid>
