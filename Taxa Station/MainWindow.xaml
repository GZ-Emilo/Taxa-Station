        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Taxa_Station"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Button x:Name="LogInButton" Content="Log In" HorizontalAlignment="Left" Margin="520,0,0,0" VerticalAlignment="Center" Height="40" Width="80" Click="LogInButton_Click"/>
        <Button x:Name="BestilTaxaButton" Content="Bestil Taxa" HorizontalAlignment="Left" VerticalAlignment="Center" Height="40" Width="80" Margin="200,0,0,0" Click="BestilTaxaButton_Click"/>

    </Grid>
</Window>
