<Window x:Class="Taxa_Station.ChaufførSide"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Taxa_Station"
        mc:Ignorable="d"
        Title="ChaufførSide" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="128*"/>
            <RowDefinition Height="89*"/>
        </Grid.RowDefinitions>
        <Button x:Name="ChaufLogUd" Content="Log Ud" HorizontalAlignment="Left" Margin="25,22,0,0" VerticalAlignment="Top" Click="ChaufLogUd_Click"/>
        <ListBox x:Name="chaufførListbox" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="508,0,0,0" Grid.RowSpan="2"/>
        <Button x:Name="sætPause" Content="Pause" Margin="289,0,0,0" VerticalAlignment="Center" Height="84" HorizontalAlignment="Left" Width="136" Click="sætPause_Click" Grid.Row="1"/>
        <Button x:Name="sætFri" Content="Fri" Margin="46,0,0,0" HorizontalAlignment="Left" Width="136" Height="84" VerticalAlignment="Center" Click="sætFri_Click" Grid.Row="1"/>
        <Button x:Name="sætUtilgængelig" Content="Utilgængelig" Margin="0,0,375,141" VerticalAlignment="Bottom" Height="84" HorizontalAlignment="Right" Width="136" Click="sætUtilgængelig_Click" Grid.RowSpan="2"/>
        <Button x:Name="sætLedig" Content="Ledig" Margin="0,0,618,141" VerticalAlignment="Bottom" Height="84" HorizontalAlignment="Right" Width="136" Click="sætLedig_Click" Grid.RowSpan="2"/>

    </Grid>
</Window>
