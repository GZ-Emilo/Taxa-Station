<Window x:Class="Taxa_Station.BestilTaxa"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Taxa_Station"
        mc:Ignorable="d"
        Title="BestilTaxa" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="297*"/>
            <ColumnDefinition Width="503*"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="Tilbage" Content="Tilbage" HorizontalAlignment="Left" Margin="25,20,0,0" VerticalAlignment="Top" Click="Tilbage_Click"/>
        <ListBox x:Name="TaxaStatus" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="278,0,0,0" SelectionChanged="TaxaStatus_SelectionChanged" Grid.Column="1"/>
        <Label Content="Vælg en Taxa" Margin="0,0,122,270" Height="26" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="79" Background="White"/>
        <Label Content="Indtast afhentningssted" HorizontalAlignment="Right" Margin="0,0,91,0" VerticalAlignment="Center" Background="White"/>
        <TextBox x:Name="afhentningssted" HorizontalAlignment="Left" Margin="236,0,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Center" Width="241" Grid.ColumnSpan="2"/>
        <Button x:Name="bestilKnap" Content="Bestil" HorizontalAlignment="Right" Margin="0,0,442,83" VerticalAlignment="Bottom" Height="44" Width="122" Grid.ColumnSpan="2" Click="bestilKnap_Click"/>
        <ListBox x:Name="ValgtTaxa" d:ItemsSource="{d:SampleData ItemCount=1}" Margin="0,0,443,270" SelectionChanged="ValgtTaxa_SelectionChanged" Grid.ColumnSpan="2" Height="26" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="120"/>
        <Image HorizontalAlignment="Left" Height="450" VerticalAlignment="Top" Width="800" Source="/resizeplus_Designer.png" Panel.ZIndex="-2" Margin="-10,-16,0,0" Grid.ColumnSpan="2"/>
        <Image HorizontalAlignment="Left" Height="126" Margin="129,20,0,0" VerticalAlignment="Top" Width="122" Panel.ZIndex="-1" Source="/Designer (2).png" Grid.Column="1"/>

    </Grid>
</Window>
